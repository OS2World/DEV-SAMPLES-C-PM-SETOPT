;-------------------------------------
; SETOPT.DEF module definition file
;-------------------------------------
NAME            SETOPT WINDOWAPI

DESCRIPTION     '@#OS2World:1.02#@##1## 2026-07-25     ARCAOS-507::::::@@SETOPT - MLE color and font sample'

CODE            PRELOAD MOVEABLE
DATA            LOADONCALL MOVEABLE MULTIPLE READWRITE
HEAPSIZE        4096
STACKSIZE       8192
EXPORTS         
                WNDPROC         = WndProc         @1
                SETFONTMSGPROC  = SETFONTMsgProc  @2
                SETCOLORMSGPROC = SETCOLORMsgProc @3
